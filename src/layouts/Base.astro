---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/prose.css";
import "../styles/tables.css";
import "../styles/code.css";
import Head from "../components/Head.astro";
import Footer from "../components/Footer.astro";
import { site } from "../site.config";

interface Props {
  title: string;
  description: string;
  path: string;
  type?: "website" | "article";
  published?: Date;
  modified?: Date;
  ogImage?: string;
  image?: string;
  jsonLd?: "person" | "post";
}
const props = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head {...props} />
  </head>
  <body>
    {props.path !== "/" && (
      <header><div class="wrap"><a class="site-name" href="/">{site.name}</a></div></header>
    )}
    <main class="wrap">
      <slot />
    </main>
    <Footer />
  </body>
</html>
